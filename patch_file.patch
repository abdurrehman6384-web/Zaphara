+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import com.rgs.companion.ui.theme.InkOn
+import com.rgs.companion.ui.theme.MutedOn
+import com.rgs.companion.ui.theme.NeonCyan
+
+/**
+ * The app's glassmorphism building block.
+ *
+ * Design constraints (kept identical across every screen):
+ *  - background: `Color.White.copy(alpha = 0.05f)` on the obsidian base
+ *  - border: 1dp — translucent white at rest, glowing neon accent when active
+ *  - 16dp rounded corners, 16dp content padding, no shadows (tonal only)
+ *  - generous spacing, separation via tint, never harsh shadows
+ */
+@Composable
+fun GlassCard(
+    modifier: Modifier = Modifier,
+    active: Boolean = false,
+    accent: Color = NeonCyan,
+    icon: ImageVector,
+    title: String,
+    subtitle: String,
+    status: String? = null,
+    statusColor: Color = MutedOn,
+    onClick: () -> Unit,
+) {
+    val shape = RoundedCornerShape(16.dp)
+    val border = if (active) accent.copy(alpha = 0.55f) else Color.White.copy(alpha = 0.1f)
+    val background = if (active) accent.copy(alpha = 0.08f) else Color.White.copy(alpha = 0.05f)
+
+    Column(
+        modifier
+            .clip(shape)
+            .background(background)
+            .border(1.dp, border, shape)
+            .clickable(onClick = onClick)
+            .padding(16.dp),
+    ) {
+        Icon(
+            imageVector = icon,
+            contentDescription = null,
+            tint = if (active) accent else Color.White.copy(alpha = 0.7f),
+            modifier = Modifier.size(22.dp),
+        )
+        Spacer(Modifier.height(10.dp))
+        Text(
+            text = title,
+            style = MaterialTheme.typography.titleSmall,
+            color = InkOn,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+        Spacer(Modifier.height(3.dp))
+        Text(
+            text = subtitle,
+            style = MaterialTheme.typography.bodySmall,
+            color = MutedOn,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+        )
+        if (status != null) {
+            Spacer(Modifier.height(10.dp))
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                BoxDot(color = statusColor)
+                Spacer(Modifier.width(6.dp))
+                Text(
+                    text = status,
+                    style = MaterialTheme.typography.labelSmall.copy(
+                        fontFamily = FontFamily.Monospace,
+                        fontSize = 10.sp,
+                        letterSpacing = 0.8.sp,
+                    ),
+                    color = statusColor,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+    }
+}
+
+/** Tiny status dot used by cards and chips. */
+@Composable
+fun BoxDot(
+    color: Color,
+    sizeDp: Int = 6,
+    modifier: Modifier = Modifier,
+) {
+    Box(
+        modifier
+            .size(sizeDp.dp)
+            .clip(CircleShape)
+            .background(color),
+    )
+}
