+package com.rgs.companion.proactive
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+
+/**
+ * Receives BOOT_COMPLETED for the proactive "she messages you first" feature.
+ *
+ * Honest state of play (see README §10): the *scheduler* is not implemented
+ * yet. `CompanionAgent.initiate()` exists and `ChatViewModel.proactive()`
+ * knows how to surface a reply, but nothing alarms itself into calling it.
+ * This receiver is the hook the manifest already declares, so the manifest is
+ * not lying; for now it logs and does nothing else.
+ */
+class BootReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        Log.i(TAG, "boot completed — proactive scheduler not yet implemented (no-op)")
+    }
+
+    private companion object {
+        const val TAG = "BootReceiver"
+    }
+}
